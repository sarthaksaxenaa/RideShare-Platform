generator client {
  provider = "prisma-client-js"
}

/**
 * 📚 DATABASE PROVIDER
 *
 * Currently using SQLite for local development (zero setup).
 * For production, switch to PostgreSQL:
 *
 *   1. Change provider below:  "sqlite"  →  "postgresql"
 *   2. Update .env DATABASE_URL to your PostgreSQL connection string
 *   3. Run: npx prisma migrate dev --name switch-to-postgres
 *
 * Free PostgreSQL hosting: Neon (neon.tech), Supabase, Railway
 */
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DriverLocation {
  driverId  String   @id
  lat       Float
  lng       Float
  updatedAt DateTime
  User      User     @relation(fields: [driverId], references: [id])
}

model EmergencyContact {
  id     String @id
  userId String
  name   String
  phone  String
  User   User   @relation(fields: [userId], references: [id])
}

model Rating {
  id                       String   @id
  tripId                   String   @unique
  fromId                   String
  toId                     String
  stars                    Int
  comment                  String?
  tags                     String?
  createdAt                DateTime @default(now())
  User_Rating_toIdToUser   User     @relation("Rating_toIdToUser", fields: [toId], references: [id])
  User_Rating_fromIdToUser User     @relation("Rating_fromIdToUser", fields: [fromId], references: [id])
  Trip                     Trip     @relation(fields: [tripId], references: [id])
}

model SavedLocation {
  id        String   @id
  userId    String
  label     String
  icon      String   @default("📍")
  lat       Float
  lng       Float
  address   String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id])

  @@unique([userId, label])
}

model Trip {
  id                       String    @id
  status                   String    @default("REQUESTED")
  riderId                  String
  driverId                 String?
  pickupLat                Float
  pickupLng                Float
  pickupAddress            String?
  dropLat                  Float
  dropLng                  Float
  dropAddress              String?
  distanceKm               Float?
  durationMin              Int?
  fare                     Int?
  baseFare                 Int?
  distanceFare             Int?
  timeFare                 Int?
  platformFee              Int?
  vehicleType              String?
  stripePaymentIntentId    String?
  paymentStatus            String    @default("PENDING")
  paymentMethod            String    @default("CARD")
  rideOtp                  String?
  createdAt                DateTime  @default(now())
  completedAt              DateTime?
  Rating                   Rating?
  User_Trip_driverIdToUser User?     @relation("Trip_driverIdToUser", fields: [driverId], references: [id])
  User_Trip_riderIdToUser  User      @relation("Trip_riderIdToUser", fields: [riderId], references: [id])
}

model User {
  id                         String             @id
  email                      String             @unique
  password                   String
  name                       String
  role                       String
  createdAt                  DateTime           @default(now())
  avatarUrl                  String?
  phone                      String?
  vehicleModel               String?
  vehicleNumber              String?
  vehicleType                String?
  DriverLocation             DriverLocation?
  EmergencyContact           EmergencyContact[]
  Rating_Rating_toIdToUser   Rating[]           @relation("Rating_toIdToUser")
  Rating_Rating_fromIdToUser Rating[]           @relation("Rating_fromIdToUser")
  SavedLocation              SavedLocation[]
  Trip_Trip_driverIdToUser   Trip[]             @relation("Trip_driverIdToUser")
  Trip_Trip_riderIdToUser    Trip[]             @relation("Trip_riderIdToUser")
}
