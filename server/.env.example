# Copy to server/.env and fill in real values. Never commit server/.env.

NODE_ENV=development
PORT=3001

# PostgreSQL connection string (Neon or local)
DATABASE_URL=postgresql://user:password@host:5432/rideshare?sslmode=require

# Long random string, 32+ characters. Generate with: openssl rand -hex 32
JWT_SECRET=change-me

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000
# Public URL of the rider app (used in referral and share links)
FRONTEND_URL=http://localhost:3000

# Stripe (test keys while developing)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional: email delivery through Resend
RESEND_API_KEY=
