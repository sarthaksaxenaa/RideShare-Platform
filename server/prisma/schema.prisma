generator client {
  provider = "prisma-client-js"
}

/**
 * 📚 DATABASE PROVIDER
 *
 * Currently using SQLite for local development (zero setup).
 * For production, switch to PostgreSQL:
 *
 *   1. Change provider below:  "sqlite"  →  "postgresql"
 *   2. Update .env DATABASE_URL to your PostgreSQL connection string
 *   3. Run: npx prisma migrate dev --name switch-to-postgres
 *
 * Free PostgreSQL hosting: Neon (neon.tech), Supabase, Railway
 */
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DriverLocation {
  driverId  String   @id
  lat       Float
  lng       Float
  updatedAt DateTime @default(now()) @updatedAt
  driver    User     @relation(fields: [driverId], references: [id])
}

model EmergencyContact {
  id     String @id @default(uuid())
  userId String
  name   String
  phone  String
  user   User   @relation(fields: [userId], references: [id])
}

model Rating {
  id        String   @id @default(uuid())
  tripId    String   @unique
  fromId    String
  toId      String
  stars     Int
  comment   String?
  tags      String?
  createdAt DateTime @default(now())
  to        User     @relation("Rating_toIdToUser", fields: [toId], references: [id])
  from      User     @relation("Rating_fromIdToUser", fields: [fromId], references: [id])
  trip      Trip     @relation(fields: [tripId], references: [id])
}

model SavedLocation {
  id        String   @id @default(uuid())
  userId    String
  label     String
  icon      String   @default("📍")
  lat       Float
  lng       Float
  address   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, label])
}

model Trip {
  id                    String    @id @default(uuid())
  status                String    @default("REQUESTED")
  riderId               String
  driverId              String?
  pickupLat             Float
  pickupLng             Float
  pickupAddress         String?
  dropLat               Float
  dropLng               Float
  dropAddress           String?
  distanceKm            Float?
  durationMin           Int?
  fare                  Int?
  baseFare              Int?
  distanceFare          Int?
  timeFare              Int?
  platformFee           Int?
  vehicleType           String?
  stripePaymentIntentId String?
  paymentStatus         String    @default("PENDING")
  paymentMethod         String    @default("CARD")
  rideOtp               String?
  createdAt             DateTime  @default(now())
  completedAt           DateTime?
  rating                Rating?
  driver                User?     @relation("Trip_driverIdToUser", fields: [driverId], references: [id])
  rider                 User      @relation("Trip_riderIdToUser", fields: [riderId], references: [id])
}

model User {
  id               String             @id @default(uuid())
  email            String             @unique
  password         String
  name             String
  role             String
  createdAt        DateTime           @default(now())
  avatarUrl        String?
  phone            String?
  vehicleModel     String?
  vehicleNumber    String?
  vehicleType      String?
  aadhaarNumber    String?
  faceImageUrl     String?    @db.Text
  vehicleImages    Json?
  driverLocation   DriverLocation?
  emergencyContacts EmergencyContact[]
  ratingsReceived  Rating[]           @relation("Rating_toIdToUser")
  ratingsGiven     Rating[]           @relation("Rating_fromIdToUser")
  savedLocations   SavedLocation[]
  tripsAsDriver    Trip[]             @relation("Trip_driverIdToUser")
  tripsAsRider     Trip[]             @relation("Trip_riderIdToUser")
}

model PromoCode {
  id          String   @id @default(uuid())
  code        String   @unique
  description String
  discountType String  @default("FLAT")  // FLAT or PERCENT
  discountValue Int    // Flat amount in rupees or percentage
  maxDiscount  Int?    // Max discount cap for percentage type
  minFare      Int     @default(0)  // Minimum fare to apply
  maxUses      Int     @default(100)
  currentUses  Int     @default(0)
  expiresAt    DateTime?
  isActive     Boolean @default(true)
  createdAt    DateTime @default(now())
}

